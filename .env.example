# ShubhShreekh — sample environment variables
#
# Copy this file, fill in real values, and DO NOT commit the copy:
#   cp .env.example .env.local        (frontend — Next.js auto-loads this)
#   cp .env.example backend/.env      (backend)
# Both `.env.local` and `.env` are covered by the `.env*` rule in .gitignore;
# only this `.env.example` is exempted and tracked in git.
#
# This file is for LOCAL DEV ONLY. Deployed values come from SSM Parameter
# Store (see plan.md's cost-control guardrails) injected via Terraform/Lambda
# env config — never from a committed .env file.
#
# See architecture.md for how these pieces fit together, and plan.md's
# "Decided: identity provider" section (MSG91 SendOTP) this file follows below.

# ============================================================================
# Frontend (Next.js) — anything prefixed NEXT_PUBLIC_ is sent to the browser.
# Never put a secret behind NEXT_PUBLIC_.
# ============================================================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Android TWA — SHA-256 cert fingerprint from `cd android && bubblewrap fingerprint list`
# Served at /.well-known/assetlinks.json for full-screen trusted web activity.
TWA_SHA256_FINGERPRINT=

# PayU merchant key may be needed client-side for checkout init.
# The matching salt / secrets are backend-only — see below.
NEXT_PUBLIC_PAYU_MERCHANT_KEY=

# ============================================================================
# Backend / Go API (backend/)
# ============================================================================

PORT=8080
AWS_REGION=ap-south-1

# Comma-separated list of frontend origins allowed to call this API
# (browser CORS — frontend and backend are always different origins, even
# in prod: app.<domain> vs api.<domain>). cmd/server defaults to
# http://localhost:3000 if unset; cmd/lambda requires it explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefer a named/SSO profile locally over long-lived keys:
#   aws configure sso --profile shubhshreekh-dev
# Only set the two keys below if you're not using AWS_PROFILE.
AWS_PROFILE=shubhshreekh-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DYNAMODB_USERS_TABLE=shubhshreekh-users-dev
DYNAMODB_SUBSCRIPTIONS_TABLE=shubhshreekh-subscriptions-dev
DYNAMODB_WATCHLISTS_TABLE=shubhshreekh-watchlists-dev
DYNAMODB_ORDERS_TABLE=shubhshreekh-orders-dev
DYNAMODB_CONTENT_TABLE=shubhshreekh-content-dev
DYNAMODB_RATELIMIT_TABLE=shubhshreekh-otp-ratelimit-dev
DYNAMODB_SETTINGS_TABLE=shubhshreekh-settings-dev
CONTENT_MEDIA_BUCKET=shubhshreekh-content-media-dev

# RA/analyst phones — granted the analyst role claim on login, gating
# /admin/insights/*. Same CSV format as OTP_TEST_PHONES. See TD-013.
ANALYST_PHONES=

# ============================================================================
# Identity provider — MSG91 SendOTP, SMS channel (decided — see plan.md's
# "Decided: identity provider" section). Values come from the MSG91
# dashboard once your account + DLT registration are set up.
# ============================================================================

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Play / QA whitelist — fixed OTP, no SMS (see TECH_DEBT.md TD-001).
# Comma-separated 10-digit Indian mobiles (or 91… / +91…). Remove in prod
# once MSG91 DLT is live for all users.
OTP_TEST_PHONES=
OTP_TEST_CODE=123456

# Backend-only secret for signing/verifying your own session tokens
# (matches backend/internal/auth's HMAC secret). Generate with:
#   openssl rand -base64 32
SESSION_TOKEN_SIGNING_SECRET=

# Biometric/PIN unlock (WebAuthn) — see backend/README.md's "Refresh without
# OTP" section. RP_ID MUST be the FRONTEND's effective domain (where
# navigator.credentials actually runs), never this API's own domain —
# app.shubhshreeknowledgehub.com in prod, localhost for local dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000

# ============================================================================
# Payments — PayU (backend-only secrets)
# ============================================================================

# Same merchant key as NEXT_PUBLIC_PAYU_MERCHANT_KEY above (if used client-side).
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_WEBHOOK_SALT=
# Optional: test vs production host (e.g. test.payu.in vs secure.payu.in)
PAYU_BASE_URL=

# ============================================================================
# Market data provider — deferred (no vendor API in MVP; see plan.md)
# ============================================================================

MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=
