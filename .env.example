# ShubhShreekh — sample environment variables
#
# Copy this file, fill in real values, and DO NOT commit the copy:
#   cp .env.example .env.local        (frontend — Next.js auto-loads this)
#   cp .env.example backend/.env      (backend, once backend/ exists — Phase 1 Week 3)
# Both `.env.local` and `.env` are covered by the `.env*` rule in .gitignore;
# only this `.env.example` is exempted and tracked in git.
#
# This file is for LOCAL DEV ONLY. Deployed values come from SSM Parameter
# Store (see plan.md's cost-control guardrails) injected via Terraform/Lambda
# env config — never from a committed .env file.
#
# See architecture.md for how these pieces fit together, and plan.md for the
# "Open decision: identity provider" section this file follows below.

# ============================================================================
# Frontend (Next.js) — anything prefixed NEXT_PUBLIC_ is sent to the browser.
# Never put a secret behind NEXT_PUBLIC_.
# ============================================================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Razorpay's Key ID is a publishable identifier, safe to expose client-side
# (checkout.js needs it). The matching Key Secret is backend-only — see below.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Only needed if Cognito is the chosen identity provider (see plan.md).
# App client IDs and the hosted-UI domain are not secret.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/callback

# ============================================================================
# Backend / Go API (backend/ — not created yet, lands in Phase 1 Week 3)
# ============================================================================

PORT=8080
AWS_REGION=ap-south-1

# Prefer a named/SSO profile locally over long-lived keys:
#   aws configure sso --profile shubhshreekh-dev
# Only set the two keys below if you're not using AWS_PROFILE.
AWS_PROFILE=shubhshreekh-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DYNAMODB_USERS_TABLE=shubhshreekh-users-dev
DYNAMODB_SUBSCRIPTIONS_TABLE=shubhshreekh-subscriptions-dev
DYNAMODB_WATCHLISTS_TABLE=shubhshreekh-watchlists-dev
DYNAMODB_ORDERS_TABLE=shubhshreekh-orders-dev

# ============================================================================
# Identity provider — STILL AN OPEN DECISION (plan.md). Keep only the block
# for whichever is chosen; delete the other.
# ============================================================================

# --- Option A: AWS Cognito ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1
COGNITO_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/<user_pool_id>/.well-known/jwks.json

# --- Option B: MSG91 / Firebase phone-OTP + your own session token ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# — or, if Firebase is chosen instead of MSG91 —
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Backend-only secret for signing/verifying your own session tokens.
# Generate with: openssl rand -base64 32
SESSION_TOKEN_SIGNING_SECRET=

# ============================================================================
# Payments — Razorpay (backend-only secrets)
# ============================================================================

# Same value as NEXT_PUBLIC_RAZORPAY_KEY_ID above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# Market data provider (delayed/free tier for MVP — see plan.md Stage 1)
# ============================================================================

MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=
