# Disposable Android/TWA build environment for Bubblewrap (TD-012).
# Not part of the app itself — delete the image when the AAB work is done:
#   docker rmi shubhshreekh-android-build
FROM node:20-bookworm

ENV ANDROID_CMDLINE_TOOLS_VERSION=15859902
ENV ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip curl && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/cmdline-tools.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" && \
    echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - && \
    mkdir -p "$ANDROID_HOME/cmdline-tools" && \
    unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" && \
    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" && \
    rm /tmp/cmdline-tools.zip

# Versions must match what Bubblewrap's generated Gradle project actually
# targets (app/build.gradle's compileSdkVersion/targetSdkVersion, and
# @bubblewrap/core's hardcoded BUILD_TOOLS_VERSION) — not just "latest".
RUN yes | sdkmanager --licenses >/dev/null && \
    sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.1.0"

# Bubblewrap's AndroidSdkTools.validatePath() still only checks for a
# top-level tools/ or bin/ dir (the pre-2021 SDK layout) — without this it
# rejects a real, working cmdline-tools-only install with "The provided
# androidSdk isn't correct." Actual binary resolution elsewhere in
# bubblewrap already uses the real cmdline-tools/latest/bin path, so this
# directory only needs to exist, not contain anything.
RUN mkdir -p "$ANDROID_HOME/tools"

RUN npm install -g @bubblewrap/cli

WORKDIR /work
